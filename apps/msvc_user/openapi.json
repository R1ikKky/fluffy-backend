{
  "openapi": "3.0.3",
  "info": {
    "title": "User Service API",
    "version": "1.0.0",
    "description": "REST API for users and contacts"
  },
  "tags": [
    {
      "name": "users",
      "description": "User CRUD and queries"
    }
  ],
  "paths": {
    "/users/get-one/{id}": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get one user by ID",
        "operationId": "getUserById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "User ID (UUID)"
          }
        ],
        "responses": {
          "200": {
            "description": "User found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserEntity"
                }
              }
            }
          },
          "404": {
            "description": "user not found"
          }
        }
      }
    },
    "/users/get-stack": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get multiple users by IDs",
        "operationId": "getUsersByIds",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated list of user IDs (UUID)"
          }
        ],
        "responses": {
          "200": {
            "description": "Users found (can be empty array)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserEntity"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/update-one/{id}": {
      "put": {
        "tags": [
          "users"
        ],
        "summary": "Update one user by ID",
        "operationId": "updateUserById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "User ID (UUID)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserDto"
              },
              "examples": {
                "validPatch": {
                  "summary": "Minimal valid patch",
                  "value": {
                    "username": "john_doe",
                    "bio": "Engineer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserEntity"
                }
              }
            }
          },
          "400": {
            "description": "invalid payload"
          },
          "404": {
            "description": "user not found"
          },
          "409": {
            "description": "username taken"
          }
        }
      }
    },
    "/users/delete-one/{id}": {
      "delete": {
        "tags": [
          "users"
        ],
        "summary": "Delete one user by ID",
        "operationId": "deleteUserById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "User ID (UUID)"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted (no content)"
          },
          "400": {
            "description": "no user exist"
          }
        }
      }
    },
    "/users/get-all": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get all users",
        "operationId": "getAllUsers",
        "responses": {
          "200": {
            "description": "All users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserEntity"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/constacts/get-all/{id}": {
      "get": {
        "tags": [
          "constacts"
        ],
        "summary": "List contacts for owner",
        "operationId": "listContacts",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Owner user ID (UUID)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of contacts (users + ids)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactListResponse"
                },
                "examples": {
                  "example": {
                    "value": {
                      "ids": [
                        "9c9d…-peer-1",
                        "0aa0…-peer-2"
                      ],
                      "users": [
                        {
                          "id": "9c9d…-peer-1",
                          "username": "alice",
                          "firstName": "Alice",
                          "secondName": "A.",
                          "avatarUrl": null,
                          "bio": null,
                          "createdAt": "2025-01-01T00:00:00.000Z",
                          "updatedAt": "2025-01-10T00:00:00.000Z",
                          "myContacts": [],
                          "inContacts": []
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/constacts/add-one/{id}": {
      "post": {
        "tags": [
          "constacts"
        ],
        "summary": "Add a contact",
        "operationId": "addContact",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Owner user ID (UUID)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactAddRequest"
              },
              "examples": {
                "ok": {
                  "value": {
                    "peerId": "48b6420b-7b91-4ab2-a7c1-96e22a3d6f71"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contact created OR already existed",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ContactEntity"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "Contact already exists": {
                          "$ref": "#/components/schemas/ContactEntity"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "mostturbation not allowed (ownerId === peerId)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 403,
                  "message": "mostturbation not allowed",
                  "error": "Forbidden"
                }
              }
            }
          },
          "404": {
            "description": "user not found (may not even exist)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 404,
                  "message": "user not found (may not even exist)",
                  "error": "Not Found"
                }
              }
            }
          }
        }
      }
    },
    "/constacts/delete-one/{id}": {
      "delete": {
        "tags": [
          "constacts"
        ],
        "summary": "Remove a contact",
        "operationId": "deleteContact",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Owner user ID (UUID)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactDeleteRequest"
              },
              "examples": {
                "ok": {
                  "value": {
                    "peerId": "48b6420b-7b91-4ab2-a7c1-96e22a3d6f71"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Deleted (no content)"
          },
          "404": {
            "description": "user not found (may not even exist)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 404,
                  "message": "user not found (may not even exist)",
                  "error": "Not Found"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserEntity": {
        "type": "object",
        "description": "User entity",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "User unique identifier"
          },
          "username": {
            "type": "string",
            "nullable": true,
            "description": "Unique username (3-32 chars, lowercase letters, digits, _ . -)",
            "pattern": "^[a-z0-9_.-]{3,32}$",
            "example": "john_doe"
          },
          "firstName": {
            "type": "string",
            "nullable": true,
            "description": "First name, up to 20 chars",
            "example": "John"
          },
          "secondName": {
            "type": "string",
            "nullable": true,
            "description": "Second name, up to 20 chars",
            "example": "Doe"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true,
            "description": "HTTPS avatar URL",
            "format": "uri",
            "pattern": "^https://",
            "example": "https://cdn.example.com/avatar.png"
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "description": "Biography, up to 500 chars",
            "maxLength": 500,
            "example": "Software engineer. Coffee lover."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp (ISO8601)"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp (ISO8601)"
          },
          "myContacts": {
            "type": "array",
            "description": "Contacts created by this user",
            "items": {
              "$ref": "#/components/schemas/ContactEntity"
            }
          },
          "inContacts": {
            "type": "array",
            "description": "Contacts where this user is a peer",
            "items": {
              "$ref": "#/components/schemas/ContactEntity"
            }
          }
        },
        "required": [
          "id",
          "createdAt",
          "updatedAt"
        ]
      },
      "ContactEntity": {
        "type": "object",
        "description": "Contact relation between two users",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Contact unique identifier"
          },
          "ownerId": {
            "type": "string",
            "format": "uuid",
            "description": "Owner user ID"
          },
          "peerId": {
            "type": "string",
            "format": "uuid",
            "description": "Peer user ID"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp (ISO8601)"
          },
          "owner": {
            "$ref": "#/components/schemas/UserEntity",
            "description": "Owner user entity"
          },
          "peer": {
            "$ref": "#/components/schemas/UserEntity",
            "description": "Peer user entity"
          }
        },
        "required": [
          "id",
          "ownerId",
          "peerId",
          "createdAt"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "description": "Patch payload for updating user",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true,
            "description": "Unique username (3-32 chars, lowercase letters, digits, _ . -)",
            "pattern": "^[a-z0-9_.-]{3,32}$",
            "example": "john_doe"
          },
          "firstName": {
            "type": "string",
            "nullable": true,
            "maxLength": 20,
            "description": "First name",
            "example": "John"
          },
          "secondName": {
            "type": "string",
            "nullable": true,
            "maxLength": 20,
            "description": "Second name",
            "example": "Doe"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "pattern": "^https://",
            "description": "HTTPS avatar URL",
            "example": "https://cdn.example.com/avatar.png"
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 500,
            "description": "Biography text",
            "example": "Software engineer. Coffee lover."
          }
        },
        "additionalProperties": false
      }
    }
  }
}