{
  "name": "@fluffy-backend/api-gateway",
  "version": "0.0.1",
  "private": true,
  "scripts": {
      "build": "nx run api-gateway:build",
      "start": "nx serve api-gateway"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@fluffy-backend/api-gateway:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@fluffy-backend/api-gateway:build:development"
          },
          "production": {
            "buildTarget": "@fluffy-backend/api-gateway:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.3",
    "@nestjs/platform-socket.io": "^11.1.3",
    "@nestjs/websockets": "^11.1.3",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.8",
    "ioredis": "^5.6.1"
  }
}
